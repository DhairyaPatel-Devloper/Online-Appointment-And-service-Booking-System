# Supabase Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit your actual .env file with real secrets.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: JDBC Configuration (Only if external Java worker/servlet is used)
DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
DB_PASSWORD=your-database-password

