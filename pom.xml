<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bookwithtech</groupId>
    <artifactId>BookWithTech</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>BookWithTech</name>
    <description>3-Tier Java Web Application — Supabase PostgreSQL backend</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <dependencies>

        <!-- ── Servlet API (Jakarta EE 9 / Tomcat 10+) ─────────────────── -->
        <!-- NOTE: If you are on NetBeans + Tomcat 9 or older, swap this for:
             groupId=javax.servlet, artifactId=javax.servlet-api, version=4.0.1
             and change all "jakarta.*" imports to "javax.*" in Servlet classes. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ── PostgreSQL JDBC Driver ─────────────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- ── HikariCP — Connection Pool ────────────────────────────── -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- ── dotenv-java — loads .env file for local dev ───────────── -->
        <!-- Reads SUPABASE_* vars from /clone/BookWithTech/.env at startup.
             On production server, set real OS environment variables instead.
             RATIONALE: cleaner for NetBeans local dev than requiring OS vars. -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ── JSON support (for REST-style servlet responses) ────────── -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- ── SLF4J + Logback (logging) ──────────────────────────────── -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.14</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warName>BookWithTech</warName>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
