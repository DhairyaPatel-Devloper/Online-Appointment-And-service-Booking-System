<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>BookWithTech</display-name>

    <!--
        NOTE: If using Tomcat 9 / javax.servlet, change the namespace above to:
        xmlns="http://xmlns.jcp.org/xml/ns/javaee"
        and version="4.0"
        Servlet mappings are handled via @WebServlet annotations — this file
        only configures session, welcome pages, and error pages.
    -->

    <!-- ── Session config ─────────────────────────────────────────────── -->
    <session-config>
        <session-timeout>30</session-timeout>     <!-- minutes -->
        <cookie-config>
            <http-only>true</http-only>
            <!-- Set secure=true when running behind HTTPS in production -->
            <!-- <secure>true</secure> -->
        </cookie-config>
    </session-config>

    <!-- ── Welcome page ───────────────────────────────────────────────── -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ── Error pages ────────────────────────────────────────────────── -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
